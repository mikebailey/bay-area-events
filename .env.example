# Copy to `.env` and replace the placeholders. `.env` is gitignored and must
# never be committed or mirrored. Project values override inherited variables.

# Free Ticketmaster Discovery API key used by code/fetch.py.
TICKETMASTER_API_KEY='REPLACE_ME'

# Optional: required only for sending the weekly/holiday email digest.
# Use a Gmail app password, not the account password. DIGEST_TO accepts a
# comma-separated list of recipients.
GMAIL_USER='REPLACE_ME'
GMAIL_APP_PASSWORD='REPLACE_ME'
DIGEST_TO='REPLACE_ME'
